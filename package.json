{
  "name": "dsh-peak-valley-meter",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/aabbcco/dsh-peak-valley-meter.git"
  },
  "homepage": "https://github.com/aabbcco/dsh-peak-valley-meter#readme",
  "bugs": { "url": "https://github.com/aabbcco/dsh-peak-valley-meter/issues" },
  "description": "峰谷时计 / Peak & Valley Meter：峰谷时段、价格与倒计时、调用消耗特效和自定义显示。",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "type": "module",
  "engines": {
    "dsh": "^0.2.1-rc.2",
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "峰谷时计",
    "summary": "峰谷时计：峰谷时段、价格与倒计时、调用消耗特效；名称、颜色、位置和动画均可配置。",
    "categories": [
      "费用",
      "Web UI",
      "观测"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "tool:peak_valley_price",
        "tool:peak_valley_settings"
      ]
    },
    "compatibility": {
      "dsh": "^0.2.1-rc.2",
      "node": ">=20"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-tools": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "peak",
    "valley",
    "off-peak",
    "tariff",
    "price",
    "峰谷",
    "峰时",
    "谷时",
    "价格",
    "倒计时"
  ],
  "author": "wyh",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
